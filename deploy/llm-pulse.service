[Unit]
Description=LLM Pulse status service
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/root/repos/llm-pulse
EnvironmentFile=/etc/llm-pulse.env
ExecStart=/usr/bin/node /root/repos/llm-pulse/apps/server/dist/index.js
Restart=always
RestartSec=5
User=root
Group=root
MemoryMax=512M
MemoryHigh=384M
CPUQuota=80%
TasksMax=128
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=no
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/var/log /root/repos/llm-pulse/apps/server/data
ReadOnlyPaths=/root/repos/llm-pulse /etc/llm-pulse.env
KillSignal=SIGINT
TimeoutStopSec=30
SyslogIdentifier=llm-pulse
StandardOutput=append:/var/log/llm-pulse.log
StandardError=append:/var/log/llm-pulse.log

[Install]
WantedBy=multi-user.target
