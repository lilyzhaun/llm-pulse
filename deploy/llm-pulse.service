[Unit]
Description=LLM Pulse BFF Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/llm-pulse

# 推荐生产做法：把敏感变量放到仓库外的 EnvironmentFile 中；
# 该模板默认假设服务以 root 运行、仓库部署在 /opt/llm-pulse。
# 如果把 WorkingDirectory 改到 /root/...，ProtectHome=yes 会遮蔽 /root 并导致 chdir 失败，需要同步调整隔离策略。
EnvironmentFile=-/etc/llm-pulse.env

# 非敏感默认值可保留在 unit 中，EnvironmentFile 仅用于覆盖或补充生产环境变量。
Environment=NODE_ENV=production
Environment=PORT=43130
Environment=PULSE_REFRESH_INTERVAL_MS=20000

# DATABASE_URL 必须由 /etc/llm-pulse.env 提供，并使用只读数据库用户。
# 示例仅使用脱敏占位值：DATABASE_URL=postgresql://llm_pulse_readonly:REDACTED_PASSWORD@postgres.example.internal:5432/newapi
# 不要把真实连接串写回仓库模板或直接硬编码在 unit 里。

# 启动前确保前端构建目录存在；服务以 root 运行时不需要额外 chown。
ExecStartPre=/bin/mkdir -p /opt/llm-pulse/apps/frontend/dist

ExecStart=/usr/bin/node /opt/llm-pulse/apps/server/dist/index.js

# 优雅关闭：SIGINT → 关 HTTP → 关上游连接池 → 退出
KillSignal=SIGINT
TimeoutStopSec=30

# 资源限制：避免查询风暴或异常缓存放大内存/CPU 占用。
MemoryMax=512M
MemoryHigh=384M
CPUQuota=80%

Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5

# 安全加固
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/llm-pulse

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llm-pulse

[Install]
WantedBy=multi-user.target
