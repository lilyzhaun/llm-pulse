{
  "name": "llm-pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-preserving model availability dashboard workspace.",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev:server & npm run dev:frontend",
    "dev:server": "npm run dev --workspace @llm-pulse/server",
    "dev:frontend": "npm run dev --workspace @llm-pulse/frontend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
